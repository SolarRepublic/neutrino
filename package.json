{
  "name": "@solar-republic/neutrino",
  "version": "1.9.0",
  "description": "Ultra light-weight client library for Secret Network",
  "homepage": "https://starshell.net/",
  "repository": "github:SolarRepublic/neutrino",
  "license": "MIT",
  "author": {
    "name": "Blake Regalia",
    "email": "blake.regalia@gmail.com",
    "url": "https://blake-regalia.com/"
  },
  "type": "module",
  "main": "dist/mjs/main.js",
  "module": "dist/mjs/main.js",
  "types": "dist/mjs/main.d.ts",
  "exports": {
    ".": {
      "types": "./dist/mjs/main.d.ts",
      "import": "./dist/mjs/main.js",
      "require": "./dist/mjs/main.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/mjs"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build:mjs": "node node_modules/@typescript/native/bin/tsc -p tsconfig.mjs.json",
    "build": "node node_modules/@typescript/native/bin/tsc -p tsconfig.mjs.json",
    "test": "node --import tsx",
    "test:all": "node test/run.mjs",
    "debug": "node --inspect-brk --import tsx",
    "typecheck": "node node_modules/@typescript/native/bin/tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test:package": "node node_modules/@typescript/native/bin/tsc -p tsconfig.mjs.json && node test/package.mjs",
    "typecheck:compat": "node node_modules/typescript/bin/tsc6 -p tsconfig.json --noEmit",
    "typecheck:floor": "node node_modules/typescript59/bin/tsc -p tsconfig.json --noEmit",
    "test:toolchain": "node test/toolchain.mjs",
    "docs": "typedoc --tsconfig tsconfig.mjs.json src/main.ts --out dist/docs",
    "test:compiled": "node test/run.mjs --compiled",
    "release:prepare": "node release/prepare.mjs",
    "test:release": "node release/verify.mjs"
  },
  "devDependencies": {
    "@blake.regalia/eslint-config-elite": "^0.7.0",
    "@blake.regalia/tsconfig": "^0.4.0",
    "@types/chai": "^5.2.3",
    "@types/node": "^24.19.1",
    "@types/web": "^0.0.358",
    "@typescript-eslint/parser": "^8.71.1",
    "chai": "^6.3.0",
    "chai-bites": "^0.3.1",
    "curve25519-js": "^0.0.4",
    "eslint": "^10.12.0",
    "tslib": "^2.8.1",
    "tsx": "^4.23.15",
    "typedoc": "^0.28.20",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "@typescript/native": "npm:typescript@7.0.2",
    "typescript59": "npm:typescript@5.9.3"
  },
  "dependencies": {
    "@blake.regalia/belt": "^0.58.0",
    "@solar-republic/contractor": "file:../contractor",
    "@solar-republic/cosmos-grpc": "file:../cosmos-grpc",
    "@solar-republic/crypto": "^0.6.2",
    "@solar-republic/types": "file:../types",
    "@solar-republic/wasm-secp256k1": "^0.6.3",
    "ts-toolbelt": "^9.6.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.34.6",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12"
  },
  "pnpm": {
    "overrides": {
      "@solar-republic/cosmos-grpc>@solar-republic/types": "file:../types",
      "@solar-republic/cosmos-grpc>@blake.regalia/belt": "^0.58.0",
      "@solar-republic/crypto>@blake.regalia/belt": "^0.58.0"
    }
  }
}
